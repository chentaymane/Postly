# Postly frontend — copy to .env.local (local) or set as Vercel env vars (prod).

# ---- Database (Neon free tier: https://neon.com) ----
# Use the POOLED connection string.
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---- Auth (Auth.js) — REQUIRED ----
# Signs session cookies/JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Public base URL of this app — OAuth redirect URIs are built from it.
# Local: http://localhost:3000    Prod: https://your-app.vercel.app
APP_BASE_URL=http://localhost:3000

# ---- Text generation ----
# Groq (primary, free): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter (fallback, optional): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Image generation uses Pollinations.ai — no API key required.

# ---- Video rendering (worker/) ----
# Shared secret the local render worker authenticates with. Same value here and
# in worker/.env. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RENDER_WORKER_TOKEN=

# ---- Aggregator: SocialAPI.ai (fallback; covers X, 10 posts/mo free) ----
# One key unlocks one-click connect + publishing for Pinterest, Instagram,
# Facebook, TikTok, LinkedIn and more — no per-platform app registration.
# Free tier: 2 profiles, 10 posts/mo. https://social-api.ai
SOCIALAPI_KEY=

# ---- Aggregator: Zernio (formerly Late) — PRIMARY ----
# One-click connect + publishing for Pinterest, Instagram, TikTok, Facebook,
# LinkedIn, Threads and YouTube. Preferred over SocialAPI because the free tier
# limits connected accounts (first 2 free) rather than metering posts.
# X/Twitter is the exception: Zernio requires a payment method for it.
# https://zernio.com
ZERNIO_API_KEY=

# ---- Platform OAuth apps (direct integrations; optional when using the
#      aggregator) ----
# Register redirect URI: {APP_BASE_URL}/api/oauth/<platform>/callback
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Facebook (Meta app -> App settings -> Basic)
META_CLIENT_ID=
META_CLIENT_SECRET=

# Instagram: these are the *Instagram* app ID/secret shown under the Meta app's
# Instagram product ("API setup with Instagram login"). They are NOT the same
# values as META_CLIENT_ID / META_CLIENT_SECRET.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
