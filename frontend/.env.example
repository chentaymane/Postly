# Postly frontend — copy to .env.local (local) or set as Vercel env vars (prod).

# ---- Database (Neon free tier: https://neon.com) ----
# Use the POOLED connection string.
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---- Auth (Auth.js) — REQUIRED ----
# Signs session cookies/JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Encrypts the API keys users store in the app (AES-256-GCM). Falls back to
# AUTH_SECRET if unset. Changing either makes every stored key unreadable and
# users must re-enter them, so set it once and keep it.
CREDENTIALS_KEY=

# Authorises the scheduler tick at /api/cron/autopilot. Without it the endpoint
# refuses every request and nothing is ever posted on schedule. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Shown as the legal contact on the Privacy and Terms pages. Set it to your own
# address before you let anyone else sign up.
LEGAL_CONTACT_EMAIL=you@example.com

# Public base URL of this app — OAuth redirect URIs are built from it.
# Local: http://localhost:3000    Prod: https://your-app.vercel.app
APP_BASE_URL=http://localhost:3000

# ---- Text generation ----
# Any ONE of these is enough; the rest act as fallbacks, tried in this order.
# Users can also add their own keys in the app (Settings -> API keys), which
# take priority over these. These are the deployment-wide defaults.
#
# Groq is free and fast: https://console.groq.com/keys
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
#
# Leave the *_MODEL vars unset. Postly asks each provider which models it
# currently serves and picks the best one it recognises. Pinning a model id
# here is a scheduled outage: when the provider retires it, every post fails
# until somebody reads a log. Set one only to force a specific model, and
# expect to change it when that model is retired.
# GROQ_MODEL=
# OPENAI_MODEL=
# GEMINI_MODEL=
# ANTHROPIC_MODEL=

# Image generation uses Pollinations.ai — no API key required.

# ---- Video rendering (worker/) ----
# Shared secret the render worker authenticates with. The same value must be
# set here, as a GitHub Actions secret, and in worker/.env if you run it
# locally. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, /api/render/* rejects every worker and NO video ever renders.
RENDER_WORKER_TOKEN=

# Rendering runs on GitHub Actions (.github/workflows/render.yml). These two
# let the app start a render the moment a video draft is created, instead of
# waiting up to 30 minutes for the workflow's own timer. Optional but strongly
# recommended: a scheduled video is generated only ~6 minutes before its slot,
# so without them videos post late.
#   Token: github.com/settings/personal-access-tokens -> fine-grained, this
#   repo only, Repository permissions -> Actions: Read and write.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=your-github-username/Postly
# Only if your workflow file or default branch is named differently.
GITHUB_RENDER_WORKFLOW=render.yml
GITHUB_RENDER_REF=main

# ---- Aggregator: SocialAPI.ai (fallback; covers X, 10 posts/mo free) ----
# One key unlocks one-click connect + publishing for Pinterest, Instagram,
# Facebook, TikTok, LinkedIn and more — no per-platform app registration.
# Free tier: 2 profiles, 10 posts/mo. https://social-api.ai
SOCIALAPI_KEY=

# ---- Aggregator: Zernio (formerly Late) — PRIMARY ----
# One-click connect + publishing for Pinterest, Instagram, TikTok, Facebook,
# LinkedIn, Threads and YouTube. Preferred over SocialAPI because the free tier
# limits connected accounts (first 2 free) rather than metering posts.
# X/Twitter is the exception: Zernio requires a payment method for it.
# https://zernio.com
ZERNIO_API_KEY=

# ---- Platform OAuth apps (direct integrations; optional when using the
#      aggregator) ----
# Register redirect URI: {APP_BASE_URL}/api/oauth/<platform>/callback
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Facebook (Meta app -> App settings -> Basic)
META_CLIENT_ID=
META_CLIENT_SECRET=

# Instagram: these are the *Instagram* app ID/secret shown under the Meta app's
# Instagram product ("API setup with Instagram login"). They are NOT the same
# values as META_CLIENT_ID / META_CLIENT_SECRET.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
