# Postly render worker — copy to worker/.env and fill in.

# ---- The app ----
POSTLY_APP_URL=http://localhost:3000
# Must match RENDER_WORKER_TOKEN in the app's environment. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
RENDER_WORKER_TOKEN=

POLL_SECONDS=60
BATCH=1

# ---- Voice (Piper, free and offline) ----
# Download the voice once:
#   mkdir -p voices && cd voices
#   wget https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/ryan/medium/en_US-ryan-medium.onnx
#   wget https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/ryan/medium/en_US-ryan-medium.onnx.json
PIPER_VOICE=voices/en_US-ryan-medium.onnx
PIPER_BIN=piper

# ---- Rendering ----
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Lower = faster on a weak CPU: ultrafast, superfast, veryfast, fast, medium.
X264_PRESET=veryfast
X264_CRF=23
# Ken Burns headroom. 1.5 is smooth and cheap; 2.0+ is smoother and slower.
KENBURNS_SCALE=1.5
# Optional music bed (any royalty-free MP3/WAV you own).
BACKGROUND_MUSIC=
BACKGROUND_MUSIC_DB=-24

# ---- Where the finished MP4 is hosted ----
# The platforms fetch the file themselves, so it needs a public HTTPS URL.
# blob | s3 | local
VIDEO_HOST=blob

# VIDEO_HOST=blob — Vercel dashboard -> Storage -> Blob -> read/write token
BLOB_READ_WRITE_TOKEN=

# VIDEO_HOST=s3 — Cloudflare R2 or any S3-compatible bucket (needs boto3)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PREFIX=postly
S3_PUBLIC_BASE_URL=

# VIDEO_HOST=local — a folder something else already serves over HTTPS
LOCAL_VIDEO_DIR=
LOCAL_PUBLIC_BASE_URL=
