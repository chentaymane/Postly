# ============================================================================
# Postly — environment configuration
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
#   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# Postgres (used by both n8n system storage and the Postly app logs DB)
# ----------------------------------------------------------------------------
POSTGRES_USER=postly
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=n8n
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# n8n
# ----------------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
# Must be reachable by external services for webhooks/OAuth callbacks.
# Local: http://localhost:5678/   Prod: https://n8n.yourdomain.com/
WEBHOOK_URL=http://localhost:5678/
# REQUIRED. Encrypts stored credentials. Generate one and keep it stable:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Keep false for local http; set true when served over https.
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=UTC

# ----------------------------------------------------------------------------
# Post-assembly microservice (Phase 3)
# ----------------------------------------------------------------------------
ASSEMBLY_PORT=3000
# URL n8n uses to reach the assembly service. Inside Docker: http://assembly:3000
ASSEMBLY_URL=http://assembly:3000

# ============================================================================
# TEXT GENERATION
# ============================================================================
# Groq (primary) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (fallback) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ============================================================================
# IMAGE GENERATION
# ============================================================================
# Pollinations.ai (primary) — no API key required.
# Hugging Face Inference API (fallback) — https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# ============================================================================
# SOCIAL PLATFORMS
# ============================================================================

# --- Meta (Facebook + Instagram share one app) ---
# https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
# Long-lived Page access token.
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# Instagram Business/Creator account ID linked to the Page.
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- X / Twitter (API v2) ---
# https://developer.twitter.com
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# --- LinkedIn ---
# https://www.linkedin.com/developers/apps
LINKEDIN_ACCESS_TOKEN=
# Organization (Company Page) URN, e.g. urn:li:organization:12345678
LINKEDIN_ORGANIZATION_URN=

# --- Pinterest (API v5) ---
# https://developers.pinterest.com
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# --- TikTok (Content Posting API) — Phase 6, optional ---
# https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ============================================================================
# NOTIFICATIONS (Phase 5) — pick whichever you use
# ============================================================================
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
